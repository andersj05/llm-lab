LLM_LAB_MODEL_PATH=/home/base/ai/qwen3-4b-thinking-2507/model
LLM_LAB_DATA_DIR=./runs
LLM_LAB_DATABASE_PATH=./runs/llm-lab.sqlite3
LLM_LAB_DEVICE=auto
LLM_LAB_DTYPE=auto
# NF4 keeps the 4B checkpoint comfortably inside an 8 GB laptop GPU.
LLM_LAB_LOAD_IN_4BIT=true
LLM_LAB_CORS_ORIGINS=http://localhost:3000
LLM_LAB_TRACE_TOKEN_LIMIT=256
# Optional overrides; the default lens location is beside the model directory.
# LLM_LAB_JLENS_PATH=/home/base/ai/qwen3-0.6b/jacobian_lens.pt
LLM_LAB_JSPACE_TOKEN_LIMIT=64
LLM_LAB_JSPACE_LAYER_STRIDE=1
NEXT_PUBLIC_LLM_LAB_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_LLM_LAB_WS_URL=ws://localhost:8000/api/v1
