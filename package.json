{
  "name": "llm-lab",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @llm-lab/web",
    "build:web": "npm run build --workspace @llm-lab/web",
    "lint:web": "npm run lint --workspace @llm-lab/web",
    "typecheck:web": "npm run typecheck --workspace @llm-lab/web",
    "test:web": "npm run test --workspace @llm-lab/web"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
